{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "noEmit": true,
    "resolveJsonModule": true,
    "useUnknownInCatchVariables": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "tests/**/*.ts"]
}
